local function holdKeyE(duration)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(duration)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function lookAtCoords(targetCoords)
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        camera.CFrame = CFrame.new(hrp.Position, targetCoords)
    end
end

local function smoothMoveTo(targetPos, speed)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    if distance < 1 then return end
    
    local timeTaken = distance / speed
    
    local pathPart = Instance.new("Part")
    pathPart.Size = Vector3.new(6, 1.2, 6)
    pathPart.Anchored = true
    pathPart.CanCollide = true
    pathPart.Transparency = 0.5
    pathPart.BrickColor = BrickColor.new("Medium stone grey")
    pathPart.Parent = workspace
    
    local startTime = tick()
    while isRunning do
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / timeTaken, 0, 1)
        local currentPos = startPos:Lerp(targetPos, alpha)
        
        if humanoid then
            humanoid.PlatformStand = true
        end
        
        hrp.CFrame = CFrame.new(currentPos)
        pathPart.Position = currentPos - Vector3.new(0, 3.5, 0)
        
        if alpha >= 1 then
            break
        end
        RunService.Heartbeat:Wait()
    end
    
    pathPart:Destroy()
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- Обновленный список точек маршрута (добавлена точка перемещения после финиша)
local routePoints = {
    Vector3.new(6844.2, 17.2, 26.4),  -- 1
    Vector3.new(6807.9, 17.4, 22.6),  -- 2
    Vector3.new(6867.9, 17.2, 45.7),  -- 3
    Vector3.new(6901.1, 17.2, 98.2),  -- 4
    Vector3.new(260.3, 17.2, 94.3),   -- 5
    Vector3.new(261.7, 17.2, -45.3),  -- 6
    Vector3.new(207.9, 21.1, -41.2),  -- 7
    Vector3.new(261.7, 17.2, -45.1),  -- 8
    Vector3.new(261.6, 17.2, 93.3),   -- 9
    Vector3.new(6937.0, 17.2, 104.4), -- 10
    Vector3.new(6812.7, 17.4, -35.1), -- 11
    Vector3.new(6854.6, 17.4, -53.7), -- 12 (перемещение после самого последнего действия)
}

local function startAutomation()
    while isRunning do
        local speed = tonumber(speedBox.Text) or 300
        
        -- 1. Перенос на первую точку
        smoothMoveTo(routePoints[1], speed)
        if not isRunning then break end
        
        -- 2. Перенос на вторую точку
        smoothMoveTo(routePoints[2], speed)
        if not isRunning then break end
        
        -- Действия на 2-й точке: камера + 6 раз по 3 сек E с паузой 1 сек
        player.CameraMode = Enum.CameraMode.LockFirstPerson
        lookAtCoords(Vector3.new(6801.3, 20.1, 23.1))
        
        for i = 1, 6 do
            if not isRunning then break end
            holdKeyE(3)
            task.wait(1)
        end
        
        if not isRunning then break end
        
        player.CameraMode = Enum.CameraMode.Classic
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        
        -- 3. Точки с 3 по 7
        for i = 3, 7 do
            if not isRunning then break end
            smoothMoveTo(routePoints[i], speed)
        end
        
        if not isRunning then break end
        
        -- Действия на 7-й точке (207.9, 21.1, -41.2):
        player.CameraMode = Enum.CameraMode.LockFirstPerson
        lookAtCoords(Vector3.new(209.4, 17.9, -41.2))
        task.wait(0.5)
        holdKeyE(3)
        task.wait(1)
        holdKeyE(3)
        
        player.CameraMode = Enum.CameraMode.Classic
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        
        if not isRunning then break end
        
        -- 4. Перемещение по точкам 8, 9, 10
        for i = 8, 10 do
            if not isRunning then break end
            smoothMoveTo(routePoints[i], speed)
        end
        
        if not isRunning then break end
        
        -- 5. Перемещение на 11-тную точку (6812.7, 17.4, -35.1)
        smoothMoveTo(routePoints[11], speed)
        if not isRunning then break end
        
        -- Действия на 11-й точке: камера на 6804.1, 17.4, -34.5, ждем 2 сек, зажимаем E на 3 сек, ждем 11 сек, зажимаем E на 3 сек
        player.CameraMode = Enum.CameraMode.LockFirstPerson
        lookAtCoords(Vector3.new(6804.1, 17.4, -34.5))
        task.wait(2)
        holdKeyE(3)
        task.wait(11)
        holdKeyE(3)
        
        player.CameraMode = Enum.CameraMode.Classic
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        
        if not isRunning then break end
        
        -- 6. Перемещение на завершающую точку круга (6854.6, 17.4, -53.7)
        smoothMoveTo(routePoints[12], speed)
        if not isRunning then break end
        
        -- Если включен анти-афк, персонаж автоматически прыгает перед началом нового круга
        if antiAfkEnabled then
            local char = player.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end
            task.wait(1)
        end
        
        -- После этого цикл автоматически начнется заново с 1-й точки!
    end
end

